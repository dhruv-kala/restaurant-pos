NODE_ENV=development
PORT=3000
APP_NAME=Restaurant POS API
API_PREFIX=api/v1

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant_pos?schema=public

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# Base64 or 64-character hex encoded 32-byte key.
COMMUNICATION_ADDRESS_ENCRYPTION_KEY=

# Example secret referenced by communication_providers.secret_reference as env:SMTP_PASSWORD.
SMTP_PASSWORD=

# Example secret referenced by an SMS provider as env:TWILIO_AUTH_TOKEN.
TWILIO_AUTH_TOKEN=
