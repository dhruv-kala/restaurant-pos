generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TRIAL
  EXPIRED
  CLOSED

  @@map("tenant_status")
}

enum OutletStatus {
  ACTIVE
  INACTIVE
  TEMPORARILY_CLOSED
  SUSPENDED
  CLOSED

  @@map("outlet_status")
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("user_status")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED

  @@map("membership_status")
}

enum DiningTableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  OUT_OF_SERVICE

  @@map("dining_table_status")
}

enum DiningTableShape {
  RECTANGLE
  SQUARE
  ROUND
  OVAL

  @@map("dining_table_shape")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("reservation_status")
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  QR_ORDER

  @@map("order_type")
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED

  @@map("order_status")
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED

  @@map("order_item_status")
}

enum OrderPriority {
  NORMAL
  HIGH
  VIP
  URGENT

  @@map("order_priority")
}

enum BillStatus {
  DRAFT
  GENERATED
  PAID
  VOID
  REFUNDED

  @@map("bill_status")
}

enum BillSource {
  POS
  WAITER
  QR
  ONLINE
  CUSTOMER_APP

  @@map("bill_source")
}

enum BillPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED

  @@map("bill_payment_status")
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  WALLET
  GIFT_CARD
  BANK_TRANSFER

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  PARTIALLY_PAID
  REFUNDED
  CANCELLED

  @@map("payment_status")
}

enum RefundStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED

  @@map("refund_status")
}

enum PaymentSource {
  POS
  WAITER_APP
  QR_ORDER
  ONLINE_ORDER
  CUSTOMER_APP

  @@map("payment_source")
}

enum ReceiptType {
  CUSTOMER_RECEIPT
  TAX_INVOICE
  DUPLICATE_COPY
  PROFORMA_INVOICE

  @@map("receipt_type")
}

enum ReceiptStatus {
  GENERATED
  PRINTED
  REPRINTED
  VOID

  @@map("receipt_status")
}

enum PrinterType {
  THERMAL_58MM
  THERMAL_80MM
  BLUETOOTH
  USB
  NETWORK
  PDF
  MOCK

  @@map("printer_type")
}

enum StockTransactionType {
  PURCHASE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  CONSUMPTION
  TRANSFER_IN
  TRANSFER_OUT
  WASTAGE
  RETURN

  @@map("stock_transaction_type")
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING
  APPROVED
  RECEIVED
  CANCELLED

  @@map("purchase_order_status")
}

enum InventoryAlertType {
  LOW_STOCK
  OUT_OF_STOCK
  EXPIRY_WARNING
  NEGATIVE_STOCK

  @@map("inventory_alert_type")
}

enum WastageReason {
  PREPARATION
  EXPIRED
  DAMAGED
  SPILLAGE
  QUALITY_REJECTION
  OTHER

  @@map("wastage_reason")
}

enum InventoryConsumptionTrigger {
  READY
  COMPLETED

  @@map("inventory_consumption_trigger")
}

enum CustomerGender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY

  @@map("customer_gender")
}

enum CustomerType {
  WALK_IN
  REGULAR
  VIP
  CORPORATE
  DELIVERY

  @@map("customer_type")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED

  @@map("customer_status")
}

enum CustomerSource {
  POS
  WAITER_APP
  QR_ORDER
  ONLINE_ORDER
  CUSTOMER_APP
  IMPORT

  @@map("customer_source")
}

enum ReportExportFormat {
  PDF
  EXCEL
  CSV

  @@map("report_export_format")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERN

  @@map("employment_type")
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED

  @@map("employee_status")
}

enum EmployeeDepartment {
  OPERATIONS
  KITCHEN
  SERVICE
  CASHIER
  MANAGEMENT
  INVENTORY
  ADMINISTRATION

  @@map("employee_department")
}

enum EmployeeGender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY

  @@map("employee_gender")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  LEAVE

  @@map("attendance_status")
}

model Tenant {
  id           String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  slug         String       @unique @db.VarChar(63)
  name         String       @db.VarChar(160)
  legalName    String?      @map("legal_name") @db.VarChar(200)
  email        String?      @db.Citext
  phone        String?      @db.VarChar(20)
  status       TenantStatus @default(ACTIVE)
  locale       String       @default("en-IN") @db.VarChar(35)
  timezone     String       @default("Asia/Kolkata") @db.VarChar(64)
  currencyCode String       @default("INR") @map("currency_code") @db.Char(3)
  outletLimit  Int          @default(1) @map("outlet_limit")
  version      Int          @default(1)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(3)

  outlets                     Outlet[]
  memberships                 TenantMembership[]
  roles                       Role[]
  menuCategories              MenuCategory[]
  menuItems                   MenuItem[]
  menuItemVariants            MenuItemVariant[]
  menuItemAddons              MenuItemAddon[]
  outletMenuPrices            OutletMenuPrice[]
  tableSections               TableSection[]
  diningTables                DiningTable[]
  tableReservations           TableReservation[]
  mergedTables                MergedTable[]
  orders                      Order[]
  orderItems                  OrderItem[]
  orderCounters               OrderNumberCounter[]
  kitchenCategories           KitchenCategory[]
  kitchenStations             KitchenStation[]
  stationAssignments          KitchenStationAssignment[]
  bills                       Bill[]
  billItems                   BillItem[]
  billTaxes                   BillTax[]
  billCounters                BillNumberCounter[]
  payments                    Payment[]
  paymentTransactions         PaymentTransaction[]
  paymentRefunds              PaymentRefund[]
  paymentCounters             PaymentNumberCounter[]
  receipts                    Receipt[]
  receiptPrintLogs            ReceiptPrintLog[]
  receiptCounters             ReceiptNumberCounter[]
  invoiceCounters             InvoiceNumberCounter[]
  inventoryCategories         InventoryCategory[]
  unitsOfMeasure              UnitOfMeasure[]
  ingredients                 Ingredient[]
  inventoryStocks             InventoryStock[]
  inventoryBatches            InventoryBatch[]
  stockTransactions           StockTransaction[]
  vendors                     Vendor[]
  purchaseOrders              PurchaseOrder[]
  purchaseOrderItems          PurchaseOrderItem[]
  purchaseOrderCounters       PurchaseOrderNumberCounter[]
  inventoryAlerts             InventoryAlert[]
  recipes                     Recipe[]
  recipeIngredients           RecipeIngredient[]
  recipeCostSnapshots         RecipeCostSnapshot[]
  productionRecipes           ProductionRecipe[]
  productionRecipeIngredients ProductionRecipeIngredient[]
  inventoryConsumptions       InventoryConsumption[]
  inventoryWastages           InventoryWastage[]
  customers                   Customer[]
  customerAddresses           CustomerAddress[]
  customerNotes               CustomerNote[]
  customerVisits              CustomerVisit[]
  customerStats               CustomerStats[]
  reportGenerationAudits      ReportGenerationAudit[]
  employeeProfiles            EmployeeProfile[]
  shifts                      Shift[]
  employeeShiftAssignments    EmployeeShiftAssignment[]
  attendanceRecords           Attendance[]
  employeePerformance         EmployeePerformance[]

  @@index([status])
  @@index([deletedAt])
  @@map("tenants")
}

model Outlet {
  id                 String                      @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenantId           String                      @map("tenant_id") @db.Uuid
  code               String                      @db.VarChar(32)
  name               String                      @db.VarChar(160)
  email              String?                     @db.Citext
  phone              String?                     @db.VarChar(20)
  addressLine1       String?                     @map("address_line_1") @db.VarChar(200)
  addressLine2       String?                     @map("address_line_2") @db.VarChar(200)
  city               String?                     @db.VarChar(100)
  state              String?                     @db.VarChar(100)
  country            String?                     @db.VarChar(2)
  postalCode         String?                     @map("postal_code") @db.VarChar(20)
  timezone           String                      @db.VarChar(64)
  status             OutletStatus                @default(ACTIVE)
  version            Int                         @default(1)
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?                   @map("deleted_at") @db.Timestamptz(3)
  allowNegativeStock Boolean                     @default(false) @map("allow_negative_stock")
  consumptionTrigger InventoryConsumptionTrigger @default(COMPLETED) @map("consumption_trigger")

  tenant                   Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membershipAssignments    MembershipOutlet[]
  menuPrices               OutletMenuPrice[]
  tableSections            TableSection[]
  diningTables             DiningTable[]
  tableReservations        TableReservation[]
  mergedTables             MergedTable[]
  orders                   Order[]
  orderCounters            OrderNumberCounter[]
  kitchenCategories        KitchenCategory[]
  kitchenStations          KitchenStation[]
  stationAssignments       KitchenStationAssignment[]
  bills                    Bill[]
  billCounters             BillNumberCounter[]
  payments                 Payment[]
  paymentCounters          PaymentNumberCounter[]
  receipts                 Receipt[]
  receiptPrintLogs         ReceiptPrintLog[]
  receiptCounters          ReceiptNumberCounter[]
  invoiceCounters          InvoiceNumberCounter[]
  inventoryStocks          InventoryStock[]
  inventoryBatches         InventoryBatch[]
  stockTransactions        StockTransaction[]
  purchaseOrders           PurchaseOrder[]
  purchaseOrderItems       PurchaseOrderItem[]
  purchaseOrderCounters    PurchaseOrderNumberCounter[]
  inventoryAlerts          InventoryAlert[]
  inventoryConsumptions    InventoryConsumption[]
  inventoryWastages        InventoryWastage[]
  customerVisits           CustomerVisit[]
  favoriteCustomerStats    CustomerStats[]              @relation("CustomerFavoriteOutlet")
  reportGenerationAudits   ReportGenerationAudit[]
  employeeProfiles         EmployeeProfile[]
  shifts                   Shift[]
  employeeShiftAssignments EmployeeShiftAssignment[]
  attendanceRecords        Attendance[]
  employeePerformance      EmployeePerformance[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("outlets")
}

model UserAccount {
  id              String     @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  email           String?    @unique @db.Citext
  phone           String?    @unique @db.VarChar(20)
  displayName     String     @map("display_name") @db.VarChar(160)
  passwordHash    String?    @map("password_hash") @db.VarChar(60)
  isPlatformAdmin Boolean    @default(false) @map("is_platform_admin")
  status          UserStatus @default(INVITED)
  version         Int        @default(1)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)

  memberships                TenantMembership[]
  refreshTokens              RefreshToken[]
  waitedOrders               Order[]                   @relation("OrderWaiter")
  generatedBills             Bill[]                    @relation("BillGeneratedBy")
  voidedBills                Bill[]                    @relation("BillVoidedBy")
  createdPayments            Payment[]                 @relation("PaymentCreatedBy")
  paidPayments               Payment[]                 @relation("PaymentPaidBy")
  paymentRefunds             PaymentRefund[]           @relation("PaymentRefundedBy")
  generatedReceipts          Receipt[]                 @relation("ReceiptGeneratedBy")
  receiptPrintLogs           ReceiptPrintLog[]         @relation("ReceiptPrintedBy")
  startedKitchenItems        OrderItem[]               @relation("KitchenItemStartedBy")
  readiedKitchenItems        OrderItem[]               @relation("KitchenItemReadiedBy")
  servedKitchenItems         OrderItem[]               @relation("KitchenItemServedBy")
  createdIngredients         Ingredient[]              @relation("IngredientCreatedBy")
  updatedIngredients         Ingredient[]              @relation("IngredientUpdatedBy")
  performedStockTransactions StockTransaction[]        @relation("StockTransactionPerformedBy")
  createdVendors             Vendor[]                  @relation("VendorCreatedBy")
  updatedVendors             Vendor[]                  @relation("VendorUpdatedBy")
  createdPurchaseOrders      PurchaseOrder[]           @relation("PurchaseOrderCreatedBy")
  updatedPurchaseOrders      PurchaseOrder[]           @relation("PurchaseOrderUpdatedBy")
  receivedPurchaseOrders     PurchaseOrder[]           @relation("PurchaseOrderReceivedBy")
  resolvedInventoryAlerts    InventoryAlert[]          @relation("InventoryAlertResolvedBy")
  createdRecipes             Recipe[]                  @relation("RecipeCreatedBy")
  updatedRecipes             Recipe[]                  @relation("RecipeUpdatedBy")
  createdProductionRecipes   ProductionRecipe[]        @relation("ProductionRecipeCreatedBy")
  updatedProductionRecipes   ProductionRecipe[]        @relation("ProductionRecipeUpdatedBy")
  triggeredConsumptions      InventoryConsumption[]    @relation("ConsumptionTriggeredBy")
  recordedWastages           InventoryWastage[]        @relation("WastageRecordedBy")
  customerNotes              CustomerNote[]            @relation("CustomerNoteCreatedBy")
  generatedReports           ReportGenerationAudit[]   @relation("ReportGeneratedBy")
  employeeProfiles           EmployeeProfile[]         @relation("EmployeeUser")
  createdEmployeeProfiles    EmployeeProfile[]         @relation("EmployeeCreatedBy")
  updatedEmployeeProfiles    EmployeeProfile[]         @relation("EmployeeUpdatedBy")
  assignedEmployeeShifts     EmployeeShiftAssignment[] @relation("ShiftAssignedBy")
  recordedAttendance         Attendance[]              @relation("AttendanceRecordedBy")

  @@index([status])
  @@index([deletedAt])
  @@map("user_accounts")
}

model RefreshToken {
  id                String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @map("token_hash") @db.VarChar(60)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model TenantMembership {
  id        String           @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    MembershipStatus @default(INVITED)
  version   Int              @default(1)
  joinedAt  DateTime?        @map("joined_at") @db.Timestamptz(3)
  revokedAt DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user              UserAccount        @relation(fields: [userId], references: [id], onDelete: Restrict)
  roleAssignments   MembershipRole[]
  outletAssignments MembershipOutlet[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([userId, status])
  @@index([tenantId, status])
  @@map("tenant_memberships")
}

model Role {
  id        String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String    @db.Citext
  systemKey String?   @map("system_key") @db.VarChar(80)
  isSystem  Boolean   @default(false) @map("is_system")
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membershipAssignments MembershipRole[]
  permissionAssignments RolePermission[]
  employeeProfiles      EmployeeProfile[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@unique([tenantId, systemKey])
  @@index([tenantId, deletedAt])
  @@map("roles")
}

model Permission {
  id            String   @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  permissionKey String   @unique @map("permission_key") @db.VarChar(120)
  module        String   @db.VarChar(50)
  description   String   @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roleAssignments RolePermission[]

  @@index([module])
  @@map("permissions")
}

model MembershipRole {
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  membership TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  role       Role             @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, membershipId, roleId])
  @@index([tenantId, roleId])
  @@map("membership_roles")
}

model RolePermission {
  tenantId     String   @map("tenant_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  constraints  Json?    @db.JsonB
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([tenantId, roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model MembershipOutlet {
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  outletId     String   @map("outlet_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  membership TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  outlet     Outlet           @relation(fields: [tenantId, outletId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, membershipId, outletId])
  @@index([tenantId, outletId])
  @@map("membership_outlets")
}

model MenuCategory {
  id           String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  parentId     String?   @map("parent_id") @db.Uuid
  name         String    @db.VarChar(120)
  description  String?   @db.VarChar(500)
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent   MenuCategory?  @relation("MenuCategoryHierarchy", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict)
  children MenuCategory[] @relation("MenuCategoryHierarchy")
  items    MenuItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, parentId])
  @@index([tenantId, name])
  @@index([tenantId, isActive, deletedAt])
  @@map("menu_categories")
}

model MenuItem {
  id            String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  categoryId    String    @map("category_id") @db.Uuid
  name          String    @db.VarChar(160)
  description   String?   @db.VarChar(1000)
  sku           String?   @db.VarChar(64)
  price         Int       @map("price_minor")
  costPrice     Int?      @map("cost_price_minor")
  imageUrl      String?   @map("image_url") @db.VarChar(2048)
  isVegetarian  Boolean   @default(false) @map("is_vegetarian")
  isVegan       Boolean   @default(false) @map("is_vegan")
  isAvailable   Boolean   @default(true) @map("is_available")
  taxPercentage Decimal   @default(0) @map("tax_percentage") @db.Decimal(5, 2)
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category           MenuCategory               @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  variants           MenuItemVariant[]
  addons             MenuItemAddon[]
  outletPrices       OutletMenuPrice[]
  orderItems         OrderItem[]
  kitchenCategory    KitchenCategory?           @relation(fields: [tenantId, kitchenCategoryId], references: [tenantId, id], onDelete: Restrict)
  kitchenCategoryId  String?                    @map("kitchen_category_id") @db.Uuid
  stationAssignments KitchenStationAssignment[]
  recipes            Recipe[]

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@index([tenantId, name])
  @@index([tenantId, isAvailable, deletedAt])
  @@map("menu_items")
}

model MenuItemVariant {
  id              String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  menuItemId      String    @map("menu_item_id") @db.Uuid
  name            String    @db.VarChar(120)
  priceAdjustment Int       @default(0) @map("price_adjustment_minor")
  isDefault       Boolean   @default(false) @map("is_default")
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  menuItem   MenuItem    @relation(fields: [tenantId, menuItemId], references: [tenantId, id], onDelete: Restrict)
  orderItems OrderItem[]
  recipes    Recipe[]

  @@unique([tenantId, id])
  @@unique([tenantId, menuItemId, name])
  @@index([tenantId, menuItemId, deletedAt])
  @@map("menu_item_variants")
}

model MenuItemAddon {
  id         String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
