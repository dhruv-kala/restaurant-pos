  lastVisitAt       DateTime? @map("last_visit_at") @db.Timestamptz(3)
  firstVisitAt      DateTime? @map("first_visit_at") @db.Timestamptz(3)
  favoriteOutletId  String?   @map("favorite_outlet_id") @db.Uuid
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer       Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  favoriteOutlet Outlet?  @relation("CustomerFavoriteOutlet", fields: [tenantId, favoriteOutletId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, customerId])
  @@index([tenantId, favoriteOutletId])
  @@map("customer_stats")
}
