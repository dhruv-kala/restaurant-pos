  orders                        Order[]
  orderItems                    OrderItem[]
  orderCounters                 OrderNumberCounter[]
  kitchenCategories             KitchenCategory[]
  kitchenStations               KitchenStation[]
  stationAssignments            KitchenStationAssignment[]
  bills                         Bill[]
  billItems                     BillItem[]
  billTaxes                     BillTax[]
  billCounters                  BillNumberCounter[]
  discountPolicies              DiscountPolicy[]
  discountApplications          DiscountApplication[]
  coupons                       Coupon[]
  promotionCampaigns            PromotionCampaign[]
  promotionCampaignOutlets      PromotionCampaignOutlet[]
  promotionRules                PromotionRule[]
  promotionRedemptions          PromotionRedemption[]
  taxProfiles                   TaxProfile[]
  taxRates                      TaxRate[]
  taxGroups                     TaxGroup[]
  taxRules                      TaxRule[]
  taxCategoryMappings           TaxCategoryMapping[]
  outletFiscalPolicies          OutletFiscalPolicy[]
  fiscalInvoiceSequences        FiscalInvoiceSequence[]
  taxCalculationSnapshots       TaxCalculationSnapshot[]
  businessDays                  BusinessDay[]
  payments                      Payment[]
  paymentTransactions           PaymentTransaction[]
  paymentRefunds                PaymentRefund[]
  paymentCounters               PaymentNumberCounter[]
  receipts                      Receipt[]
  receiptPrintLogs              ReceiptPrintLog[]
  receiptCounters               ReceiptNumberCounter[]
  invoiceCounters               InvoiceNumberCounter[]
  inventoryCategories           InventoryCategory[]
  unitsOfMeasure                UnitOfMeasure[]
  ingredients                   Ingredient[]
  inventoryStocks               InventoryStock[]
  inventoryBatches              InventoryBatch[]
  stockTransactions             StockTransaction[]
  vendors                       Vendor[]
  purchaseOrders                PurchaseOrder[]
  purchaseOrderItems            PurchaseOrderItem[]
  purchaseOrderCounters         PurchaseOrderNumberCounter[]
  inventoryAlerts               InventoryAlert[]
  recipes                       Recipe[]
  recipeIngredients             RecipeIngredient[]
  recipeCostSnapshots           RecipeCostSnapshot[]
  productionRecipes             ProductionRecipe[]
  productionRecipeIngredients   ProductionRecipeIngredient[]
  inventoryConsumptions         InventoryConsumption[]
  inventoryWastages             InventoryWastage[]
  customers                     Customer[]
  customerAddresses             CustomerAddress[]
  customerNotes                 CustomerNote[]
  customerVisits                CustomerVisit[]
  customerStats                 CustomerStats[]
  reportGenerationAudits        ReportGenerationAudit[]
  employeeProfiles              EmployeeProfile[]
  shifts                        Shift[]
  employeeShiftAssignments      EmployeeShiftAssignment[]
  attendanceRecords             Attendance[]
  employeePerformance           EmployeePerformance[]
  auditEvents                   AuditEvent[]
  notifications                 Notification[]
  notificationRecipients        NotificationRecipient[]
  notificationPreferences       NotificationPreference[]
