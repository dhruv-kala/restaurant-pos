model Outlet {
  id                 String                      @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenantId           String                      @map("tenant_id") @db.Uuid
  code               String                      @db.VarChar(32)
  name               String                      @db.VarChar(160)
  email              String?                     @db.Citext
  phone              String?                     @db.VarChar(20)
  addressLine1       String?                     @map("address_line_1") @db.VarChar(200)
  addressLine2       String?                     @map("address_line_2") @db.VarChar(200)
  city               String?                     @db.VarChar(100)
  state              String?                     @db.VarChar(100)
  country            String?                     @db.VarChar(2)
  postalCode         String?                     @map("postal_code") @db.VarChar(20)
  timezone           String                      @db.VarChar(64)
  status             OutletStatus                @default(ACTIVE)
  version            Int                         @default(1)
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?                   @map("deleted_at") @db.Timestamptz(3)
  allowNegativeStock Boolean                     @default(false) @map("allow_negative_stock")
  consumptionTrigger InventoryConsumptionTrigger @default(COMPLETED) @map("consumption_trigger")

  tenant                   Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membershipAssignments    MembershipOutlet[]
  menuPrices               OutletMenuPrice[]
  tableSections            TableSection[]
  diningTables             DiningTable[]
  tableReservations        TableReservation[]
  mergedTables             MergedTable[]
  orders                   Order[]
  orderCounters            OrderNumberCounter[]
  kitchenCategories        KitchenCategory[]
  kitchenStations          KitchenStation[]
  stationAssignments       KitchenStationAssignment[]
  bills                    Bill[]
  billCounters             BillNumberCounter[]
  discountPolicies         DiscountPolicy[]
  discountApplications     DiscountApplication[]
  coupons                  Coupon[]
  promotionCampaignOutlets PromotionCampaignOutlet[]
  promotionRedemptions     PromotionRedemption[]
  payments                 Payment[]
  paymentCounters          PaymentNumberCounter[]
  receipts                 Receipt[]
  receiptPrintLogs         ReceiptPrintLog[]
  receiptCounters          ReceiptNumberCounter[]
  invoiceCounters          InvoiceNumberCounter[]
  inventoryStocks          InventoryStock[]
  inventoryBatches         InventoryBatch[]
  stockTransactions        StockTransaction[]
  purchaseOrders           PurchaseOrder[]
  purchaseOrderItems       PurchaseOrderItem[]
  purchaseOrderCounters    PurchaseOrderNumberCounter[]
  inventoryAlerts          InventoryAlert[]
  inventoryConsumptions    InventoryConsumption[]
  inventoryWastages        InventoryWastage[]
  customerVisits           CustomerVisit[]
  favoriteCustomerStats    CustomerStats[]              @relation("CustomerFavoriteOutlet")
  reportGenerationAudits   ReportGenerationAudit[]
  employeeProfiles         EmployeeProfile[]
  shifts                   Shift[]
  employeeShiftAssignments EmployeeShiftAssignment[]
  attendanceRecords        Attendance[]
  employeePerformance      EmployeePerformance[]
  auditEvents              AuditEvent[]
  notifications            Notification[]
  communicationMessages    CommunicationMessage[]
  communicationPushDevices CommunicationPushDevice[]
  fiscalPolicies           OutletFiscalPolicy[]
  fiscalInvoiceSequences   FiscalInvoiceSequence[]
  taxCalculationSnapshots  TaxCalculationSnapshot[]
  businessDays             BusinessDay[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("outlets")
}

model UserAccount {
  id              String     @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  email           String?    @unique @db.Citext
  phone           String?    @unique @db.VarChar(20)
  displayName     String     @map("display_name") @db.VarChar(160)
