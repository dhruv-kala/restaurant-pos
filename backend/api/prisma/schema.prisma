  discountAmount          Int           @default(0) @map("discount_amount_minor")
  taxAmount               Int           @default(0) @map("tax_amount_minor")
  serviceChargeAmount     Int           @default(0) @map("service_charge_amount_minor")
  grandTotal              Int           @default(0) @map("grand_total_minor")
  cancellationReason      String?       @map("cancellation_reason") @db.VarChar(500)
  completedAt             DateTime?     @map("completed_at") @db.Timestamptz(3)
  cancelledAt             DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  version                 Int           @default(1)
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet Outlet       @relation(fields: [tenantId, outletId], references: [tenantId, id], onDelete: Restrict)
