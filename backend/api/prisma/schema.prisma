generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TRIAL
  EXPIRED
  CLOSED

  @@map("tenant_status")
}

enum OutletStatus {
  ACTIVE
  INACTIVE
  TEMPORARILY_CLOSED
  SUSPENDED
  CLOSED

  @@map("outlet_status")
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("user_status")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED

  @@map("membership_status")
}

enum DiningTableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  OUT_OF_SERVICE

  @@map("dining_table_status")
}

enum DiningTableShape {
  RECTANGLE
  SQUARE
  ROUND
  OVAL

  @@map("dining_table_shape")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("reservation_status")
}

model Tenant {
  id           String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  slug         String       @unique @db.VarChar(63)
  name         String       @db.VarChar(160)
  legalName    String?      @map("legal_name") @db.VarChar(200)
  email        String?      @db.Citext
  phone        String?      @db.VarChar(20)
  status       TenantStatus @default(ACTIVE)
  locale       String       @default("en-IN") @db.VarChar(35)
  timezone     String       @default("Asia/Kolkata") @db.VarChar(64)
  currencyCode String       @default("INR") @map("currency_code") @db.Char(3)
  outletLimit  Int          @default(1) @map("outlet_limit")
  version      Int          @default(1)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(3)

  outlets           Outlet[]
  memberships       TenantMembership[]
  roles             Role[]
  menuCategories    MenuCategory[]
  menuItems         MenuItem[]
  menuItemVariants  MenuItemVariant[]
  menuItemAddons    MenuItemAddon[]
  outletMenuPrices  OutletMenuPrice[]
  tableSections     TableSection[]
  diningTables      DiningTable[]
  tableReservations TableReservation[]
  mergedTables      MergedTable[]

  @@index([status])
  @@index([deletedAt])
  @@map("tenants")
}

model Outlet {
  id           String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  code         String       @db.VarChar(32)
  name         String       @db.VarChar(160)
  email        String?      @db.Citext
  phone        String?      @db.VarChar(20)
  addressLine1 String?      @map("address_line_1") @db.VarChar(200)
  addressLine2 String?      @map("address_line_2") @db.VarChar(200)
  city         String?      @db.VarChar(100)
  state        String?      @db.VarChar(100)
  country      String?      @db.VarChar(2)
  postalCode   String?      @map("postal_code") @db.VarChar(20)
  timezone     String       @db.VarChar(64)
  status       OutletStatus @default(ACTIVE)
  version      Int          @default(1)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(3)

  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membershipAssignments MembershipOutlet[]
  menuPrices            OutletMenuPrice[]
  tableSections         TableSection[]
  diningTables          DiningTable[]
  tableReservations     TableReservation[]
  mergedTables          MergedTable[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("outlets")
}

model UserAccount {
  id              String     @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  email           String?    @unique @db.Citext
  phone           String?    @unique @db.VarChar(20)
  displayName     String     @map("display_name") @db.VarChar(160)
  passwordHash    String?    @map("password_hash") @db.VarChar(60)
  isPlatformAdmin Boolean    @default(false) @map("is_platform_admin")
  status          UserStatus @default(INVITED)
  version         Int        @default(1)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)

  memberships   TenantMembership[]
  refreshTokens RefreshToken[]

  @@index([status])
  @@index([deletedAt])
  @@map("user_accounts")
}

model RefreshToken {
  id                String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @map("token_hash") @db.VarChar(60)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model TenantMembership {
  id        String           @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    MembershipStatus @default(INVITED)
  version   Int              @default(1)
  joinedAt  DateTime?        @map("joined_at") @db.Timestamptz(3)
  revokedAt DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user              UserAccount        @relation(fields: [userId], references: [id], onDelete: Restrict)
  roleAssignments   MembershipRole[]
  outletAssignments MembershipOutlet[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([userId, status])
  @@index([tenantId, status])
  @@map("tenant_memberships")
}

model Role {
  id        String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String    @db.Citext
  systemKey String?   @map("system_key") @db.VarChar(80)
  isSystem  Boolean   @default(false) @map("is_system")
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membershipAssignments MembershipRole[]
  permissionAssignments RolePermission[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@unique([tenantId, systemKey])
  @@index([tenantId, deletedAt])
  @@map("roles")
}

model Permission {
  id            String   @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  permissionKey String   @unique @map("permission_key") @db.VarChar(120)
  module        String   @db.VarChar(50)
  description   String   @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roleAssignments RolePermission[]

  @@index([module])
  @@map("permissions")
}

model MembershipRole {
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  membership TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  role       Role             @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, membershipId, roleId])
  @@index([tenantId, roleId])
  @@map("membership_roles")
}

model RolePermission {
  tenantId     String   @map("tenant_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  constraints  Json?    @db.JsonB
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([tenantId, roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model MembershipOutlet {
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  outletId     String   @map("outlet_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  membership TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  outlet     Outlet           @relation(fields: [tenantId, outletId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, membershipId, outletId])
  @@index([tenantId, outletId])
  @@map("membership_outlets")
}

model MenuCategory {
  id           String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  parentId     String?   @map("parent_id") @db.Uuid
  name         String    @db.VarChar(120)
  description  String?   @db.VarChar(500)
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent   MenuCategory?  @relation("MenuCategoryHierarchy", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict)
  children MenuCategory[] @relation("MenuCategoryHierarchy")
  items    MenuItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, parentId])
  @@index([tenantId, name])
  @@index([tenantId, isActive, deletedAt])
  @@map("menu_categories")
}

model MenuItem {
  id            String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  categoryId    String    @map("category_id") @db.Uuid
  name          String    @db.VarChar(160)
  description   String?   @db.VarChar(1000)
  sku           String?   @db.VarChar(64)
  price         Int       @map("price_minor")
  costPrice     Int?      @map("cost_price_minor")
  imageUrl      String?   @map("image_url") @db.VarChar(2048)
  isVegetarian  Boolean   @default(false) @map("is_vegetarian")
  isVegan       Boolean   @default(false) @map("is_vegan")
  isAvailable   Boolean   @default(true) @map("is_available")
  taxPercentage Decimal   @default(0) @map("tax_percentage") @db.Decimal(5, 2)
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category     MenuCategory      @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  variants     MenuItemVariant[]
  addons       MenuItemAddon[]
  outletPrices OutletMenuPrice[]

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@index([tenantId, name])
  @@index([tenantId, isAvailable, deletedAt])
  @@map("menu_items")
}

model MenuItemVariant {
  id              String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  menuItemId      String    @map("menu_item_id") @db.Uuid
  name            String    @db.VarChar(120)
  priceAdjustment Int       @default(0) @map("price_adjustment_minor")
  isDefault       Boolean   @default(false) @map("is_default")
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  menuItem MenuItem @relation(fields: [tenantId, menuItemId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, menuItemId, name])
  @@index([tenantId, menuItemId, deletedAt])
  @@map("menu_item_variants")
}

model MenuItemAddon {
  id         String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  menuItemId String    @map("menu_item_id") @db.Uuid
  name       String    @db.VarChar(120)
  price      Int       @map("price_minor")
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  menuItem MenuItem @relation(fields: [tenantId, menuItemId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, menuItemId, name])
  @@index([tenantId, menuItemId, deletedAt])
  @@map("menu_item_addons")
}

model OutletMenuPrice {
  id         String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  outletId   String    @map("outlet_id") @db.Uuid
  menuItemId String    @map("menu_item_id") @db.Uuid
  price      Int       @map("price_minor")
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet   Outlet   @relation(fields: [tenantId, outletId], references: [tenantId, id], onDelete: Restrict)
  menuItem MenuItem @relation(fields: [tenantId, menuItemId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, outletId, menuItemId])
  @@index([tenantId, menuItemId, deletedAt])
  @@index([tenantId, outletId, deletedAt])
  @@map("outlet_menu_prices")
}

model TableSection {
  id           String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  outletId     String    @map("outlet_id") @db.Uuid
  name         String    @db.VarChar(120)
  description  String?   @db.VarChar(500)
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet Outlet        @relation(fields: [tenantId, outletId], references: [tenantId, id], onDelete: Restrict)
  tables DiningTable[]

  @@unique([tenantId, id])
  @@unique([tenantId, outletId, id])
  @@unique([tenantId, outletId, name])
  @@index([tenantId, outletId, isActive, deletedAt])
  @@map("table_sections")
}

model DiningTable {
  id          String            @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  outletId    String            @map("outlet_id") @db.Uuid
  sectionId   String            @map("section_id") @db.Uuid
  tableNumber String            @map("table_number") @db.VarChar(32)
  displayName String?           @map("display_name") @db.VarChar(120)
  capacity    Int
  status      DiningTableStatus @default(AVAILABLE)
  xPosition   Decimal           @default(0) @map("x_position") @db.Decimal(10, 2)
  yPosition   Decimal           @default(0) @map("y_position") @db.Decimal(10, 2)
  shape       DiningTableShape  @default(RECTANGLE)
  isActive    Boolean           @default(true) @map("is_active")
  version     Int               @default(1)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?         @map("deleted_at") @db.Timestamptz(3)

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet       Outlet             @relation(fields: [tenantId, outletId], references: [tenantId, id], onDelete: Restrict)
  section      TableSection       @relation(fields: [tenantId, outletId, sectionId], references: [tenantId, outletId, id], onDelete: Restrict)
  reservations TableReservation[]

  @@unique([tenantId, id])
  @@unique([tenantId, outletId, id])
  @@unique([tenantId, outletId, tableNumber])
  @@index([tenantId, outletId, sectionId])
  @@index([tenantId, outletId, status, deletedAt])
  @@map("dining_tables")
}

model TableReservation {
  id                  String            @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenantId            String            @map("tenant_id") @db.Uuid
  outletId            String            @map("outlet_id") @db.Uuid
  tableId             String            @map("table_id") @db.Uuid
  customerName        String            @map("customer_name") @db.VarChar(160)
  customerPhone       String?           @map("customer_phone") @db.VarChar(20)
  reservationDate     DateTime          @map("reservation_date") @db.Timestamptz(3)
  guestCount          Int               @map("guest_count")
  specialInstructions String?           @map("special_instructions") @db.VarChar(1000)
  status              ReservationStatus @default(PENDING)
  version             Int               @default(1)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?         @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet Outlet      @relation(fields: [tenantId, outletId], references: [tenantId, id], onDelete: Restrict)
  table  DiningTable @relation(fields: [tenantId, outletId, tableId], references: [tenantId, outletId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, outletId, reservationDate])
  @@index([tenantId, outletId, tableId, status])
  @@map("table_reservations")
}

model MergedTable {
  id             String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  outletId       String    @map("outlet_id") @db.Uuid
  primaryTableId String    @map("primary_table_id") @db.Uuid
  mergedTableIds String[]  @map("merged_table_ids") @db.Uuid
  isActive       Boolean   @default(true) @map("is_active")
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet Outlet @relation(fields: [tenantId, outletId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, outletId, isActive, deletedAt])
  @@map("merged_tables")
}
